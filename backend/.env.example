# ---- 基础 ----
APP_NAME=serv00-mail
SECRET_KEY=请改成随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 数据库（serv00 面板创建的 MySQL）----
DATABASE_URL=mysql+pymysql://dbuser:dbpass@localhost:3306/dbname

# ---- serv00 邮件服务器（去面板 Mail 页面确认主机名；一般为 mail<编号>.serv00.com）----
# 实测示例（panel8/s8）：mail8.serv00.com
SERV00_IMAP_HOST=mail.serv00.com
SERV00_IMAP_PORT=993
SERV00_SMTP_HOST=mail.serv00.com
SERV00_SMTP_PORT=587
SERV00_SMTP_STARTTLS=true

# ---- 默认域名 ----
DEFAULT_DOMAIN=example.com

# ---- 方案 B 别名用的主邮箱（需在面板开好 catch-all 指向它）----
MASTER_IMAP_USER=master@example.com
MASTER_IMAP_PASS=主邮箱密码

# ---- serv00 面板（方案 A 自动建邮箱用；地址形如 https://panel<编号>.serv00.com）----
# 实测：添加邮箱接口为 POST /mail/add，字段 email / password1 / password2（2026-10-12 于 panel8 验证）
SERV00_PANEL_URL=https://panel1.serv00.com
SERV00_PANEL_USER=你的serv00用户名
SERV00_PANEL_PASS=你的serv00密码

# ---- 邮箱密码加密密钥（生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）----
FERNET_KEY=

# ---- 默认开关（也可在管理后台随时改，数据库里的值优先）----
DEFAULT_ALLOW_REGISTER=true
DEFAULT_ALLOW_SEND=true

# ---- 建邮箱频率限制（每用户每小时）----
MAILBOX_CREATE_LIMIT_PER_HOUR=20
